       \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m                      \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m\r\n\u001b[2m├──────\u001b[22m\u001b[2m┼───────────────────────────────────────────────────────\u001b[22m\u001b[2m┼────────────\u001b[22m\u001b[2m┼──────────────────────\u001b[22m\u001b[2m┼────────────┤\u001b[22m\r\n\u001b[2m│\u001b[22m \u001b[2m#45… \u001b[2m│\u001b[22m Database Advisor lint links don't properly encode     \u001b[2m│\u001b[22m \u001b[33mopen\u001b[39m       \u001b[2m│\u001b[22m oniani1,             \u001b[2m│\u001b[22m \u001b[2m-\u001b[22m          \u001b[2m│\u001b[22m\r\n\u001b[2m│\u001b[22m      \u001b[2m│\u001b[22m special characters in schema or table names, breaking \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m victoriahughes497-m… \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m\r\n\u001b[2m│\u001b[22m      \u001b[2m│\u001b[22m URL query parameters                                  \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m                      \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m\r\n\u001b[2m├──────\u001b[22m\u001b[2m┼───────────────────────────────────────────────────────\u001b[22m\u001b[2m┼────────────\u001b[22m\u001b[2m┼──────────────────────\u001b[22m\u001b[2m┼────────────┤\u001b[22m\r\n\u001b[2m│\u001b[22m \u001b[2m#45… \u001b[2m│\u001b[22m User unable to update Auth URL Configuration for      \u001b[2m│\u001b[22m \u001b[32mresolved\u001b[39m   \u001b[2m│\u001b[22m suhailzalia-arch,    \u001b[2m│\u001b[22m \u001b[2m-\u001b[22m          \u001b[2m│\u001b[22m\r\n\u001b[2m│\u001b[22m      \u001b[2m│\u001b[22m Lovable Cloud managed Supabase project due to access  \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m Hallidayo,           \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m\r\n\u001b[2m│\u001b[22m      \u001b[2m│\u001b[22m restrictions, blocking production launch              \u001b[2m│\u001b[22m            \u001b[2m│\u001b[22m victoriahughes497-m… \u001b[2m│\u0